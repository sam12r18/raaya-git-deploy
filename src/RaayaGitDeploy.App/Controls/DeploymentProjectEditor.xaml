<UserControl
    x:Class="RaayaGitDeploy.App.Controls.DeploymentProjectEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <x:Double x:Key="M3SectionSpacing">24</x:Double>
        <x:Double x:Key="M3FieldSpacing">12</x:Double>
        <CornerRadius x:Key="M3ContainerShape">16</CornerRadius>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Spacing="{StaticResource M3SectionSpacing}">
            <StackPanel Spacing="4">
                <TextBlock Text="Deployment project" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Connect a repository and branch to a safe host mapping. Credentials are managed separately." TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>

            <Border CornerRadius="{StaticResource M3ContainerShape}" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="{StaticResource M3FieldSpacing}">
                    <TextBlock Text="Source" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="ProjectName" Header="Project name" PlaceholderText="Storefront production" />
                    <TextBox x:Name="RepositoryRoot" Header="Local repository" PlaceholderText="C:\projects\shop" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RemoteName" Header="Git remote" Text="origin" />
                        <TextBox x:Name="BranchName" Grid.Column="1" Header="Branch" Text="main" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="{StaticResource M3ContainerShape}" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="{StaticResource M3FieldSpacing}">
                    <TextBlock Text="Target mapping" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="ServerProfileId" Header="Host profile" PlaceholderText="Select a validated host profile" />
                    <TextBox x:Name="ApplicationRoot" Header="Application root" PlaceholderText="/home/user/core" />
                    <TextBox x:Name="PublicRoot" Header="Public root (optional)" PlaceholderText="/home/user/public_html" />
                    <ComboBox x:Name="Strategy" Header="Deployment strategy" SelectedIndex="0">
                        <ComboBoxItem Content="File sync" Tag="FileSync" />
                        <ComboBoxItem Content="Laravel" Tag="Laravel" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border CornerRadius="{StaticResource M3ContainerShape}" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="{StaticResource M3FieldSpacing}">
                    <TextBlock Text="Protected production paths" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="These repository-relative paths are always skipped by the deployment plan." TextWrapping="Wrap" Opacity="0.72" />
                    <TextBox x:Name="ProtectedPaths" Header="One path per line" Text=".env&#x0a;storage&#x0a;uploads" AcceptsReturn="True" MinHeight="112" FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ValidationInfo" Severity="Error" IsOpen="False" IsClosable="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" />
                <Button Content="Validate project" Click="ValidateProject_Click" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
