<Page x:Class="RaayaGitDeploy.App.Views.RepositoryWorkspacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Repository Workspace" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.RepositoryPath, Mode=OneWay}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.AbbreviatedHeadSha, Mode=OneWay}" FontFamily="Consolas"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Open Repository" Click="OpenRepository_Click"/><Button Content="Refresh" Click="WorkingTree_Click"/></StackPanel></Grid>
<Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NavigationView x:Name="WorkbenchNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" PaneDisplayMode="LeftCompact" SelectionChanged="WorkbenchNavigation_SelectionChanged"><NavigationView.MenuItems><NavigationViewItem Content="Changes" Tag="Changes"/><NavigationViewItem Content="Commits" Tag="Commits"/><NavigationViewItem Content="Terminal" Tag="Terminal"/><NavigationViewItem Content="Commands" Tag="Commands"/><NavigationViewItem Content="Deploy Queue" Tag="DeployQueue"/><NavigationViewItem Content="Servers" Tag="Servers"/><NavigationViewItem Content="History" Tag="History"/></NavigationView.MenuItems></NavigationView>
<Grid Grid.Column="1"><Grid x:Name="ChangesWorkspace"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="BaseRefTextBox" Width="180" PlaceholderText="Compare ref"/><Button Content="Compare" Click="Compare_Click"/></StackPanel><ListView x:Name="ChangesList" ItemsSource="{x:Bind ViewModel.Changes}" SelectionChanged="ChangesList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" FontFamily="Consolas"/></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><ScrollViewer Grid.Column="1"><TextBlock Text="{x:Bind ViewModel.SelectedDiffText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer></Grid></Grid>
<Grid x:Name="CommitsWorkspace" Visibility="Collapsed" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions><ListView x:Name="CommitsList" ItemsSource="{x:Bind ViewModel.Commits}" SelectionChanged="CommitsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Subject}"/><TextBlock Text="{Binding ShortSha}" FontFamily="Consolas"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><ListView Grid.Column="1" x:Name="CommitFilesList" ItemsSource="{x:Bind ViewModel.CommitChanges}" SelectionChanged="CommitFilesList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}"/></DataTemplate></ListView.ItemTemplate></ListView><ScrollViewer Grid.Column="2"><TextBlock Text="{x:Bind ViewModel.SelectedCommitDiffText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer></Grid>
<Grid x:Name="TerminalWorkspace" Visibility="Collapsed" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Terminal"/><TextBlock x:Name="TerminalState" Text="Stopped"/><Button Content="Start / Restart" Click="TerminalStart_Click"/><Button Content="Stop" Click="TerminalStop_Click"/></StackPanel><ScrollViewer Grid.Row="1"><TextBlock x:Name="TerminalOutput" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer><Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TerminalInput" PlaceholderText="PowerShell command"/><Button Grid.Column="1" Content="Run" Click="TerminalSend_Click"/></Grid></Grid>
<Grid x:Name="CommandsWorkspace" Visibility="Collapsed" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Saved Commands" Style="{ThemeResource TitleTextBlockStyle}"/><ListView x:Name="CommandsList" SelectionChanged="CommandsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CommandText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Command" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBox x:Name="CommandName" Header="Name"/><TextBox x:Name="CommandText" Header="Command" FontFamily="Consolas" AcceptsReturn="True"/><TextBox x:Name="CommandWorkingDirectory" Header="Working directory override (optional)"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="New" Click="CommandNew_Click"/><Button Content="Save" Click="CommandSave_Click"/><Button Content="Run" Click="CommandRun_Click"/><Button Content="Delete" Click="CommandDelete_Click"/></StackPanel><TextBlock Text="Commands run only when you press Run. Without an override they run in the open repository." TextWrapping="Wrap" Opacity="0.72"/></StackPanel></Grid>
<StackPanel x:Name="DeployQueueWorkspace" Visibility="Collapsed"><TextBlock Text="Deploy Queue"/><TextBlock Text="Deployment queue is next in the end-to-end flow."/></StackPanel><StackPanel x:Name="ServersWorkspace" Visibility="Collapsed"><TextBlock Text="Servers"/><TextBlock Text="Server profiles are next in the end-to-end flow."/></StackPanel><StackPanel x:Name="HistoryWorkspace" Visibility="Collapsed"><TextBlock Text="History"/></StackPanel></Grid></Grid>
<InfoBar x:Name="ErrorInfoBar" Grid.RowSpan="2" IsOpen="False" Severity="Error" IsClosable="True" VerticalAlignment="Top"/></Grid></Page>
