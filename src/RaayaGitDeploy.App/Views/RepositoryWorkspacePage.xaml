<Page
    x:Class="RaayaGitDeploy.App.Views.RepositoryWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Repository Workspace" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.RepositoryPath, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.AbbreviatedHeadSha, Mode=OneWay}" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Open Repository" Click="OpenRepository_Click" />
                <Button Content="Refresh" Click="WorkingTree_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <NavigationView x:Name="WorkbenchNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" PaneDisplayMode="LeftCompact" SelectionChanged="WorkbenchNavigation_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Changes" Tag="Changes"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Commits" Tag="Commits"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Terminal" Tag="Terminal"><NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Commands" Tag="Commands"><NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Deploy Queue" Tag="DeployQueue"><NavigationViewItem.Icon><SymbolIcon Symbol="Upload" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Servers" Tag="Servers"><NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="History" Tag="History"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="ChangesWorkspace">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="BaseRefTextBox" Width="180" PlaceholderText="Compare ref" />
                                <Button Content="Compare" Click="Compare_Click" />
                            </StackPanel>
                            <ListView x:Name="ChangesList" ItemsSource="{x:Bind ViewModel.Changes}" SelectionChanged="ChangesList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="4">
                                            <TextBlock Text="{Binding Path}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Kind}" />
                                                <TextBlock Text="{Binding IsStaged, StringFormat='Staged: {0}'}" />
                                                <TextBlock Text="{Binding IsUnstaged, StringFormat='Unstaged: {0}'}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Diff Inspector" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.SelectedDiffText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel x:Name="CommitsWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Commits" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Recent commits, changed files, and commit diff will appear here." Opacity="0.72" />
                </StackPanel>
                <StackPanel x:Name="TerminalWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Terminal" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Repository-aware PowerShell terminal will appear here." Opacity="0.72" />
                </StackPanel>
                <StackPanel x:Name="CommandsWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Commands" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Saved build, test, and project commands will appear here." Opacity="0.72" />
                </StackPanel>
                <StackPanel x:Name="DeployQueueWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Deploy Queue" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Selected and manually added deployment items will appear here." Opacity="0.72" />
                </StackPanel>
                <StackPanel x:Name="ServersWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Servers" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Server profiles and connection settings will appear here." Opacity="0.72" />
                </StackPanel>
                <StackPanel x:Name="HistoryWorkspace" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="History" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Deployment history and per-item results will appear here." Opacity="0.72" />
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar x:Name="ErrorInfoBar" Grid.RowSpan="2" IsOpen="False" Severity="Error" IsClosable="True" VerticalAlignment="Top" />
    </Grid>
</Page>
