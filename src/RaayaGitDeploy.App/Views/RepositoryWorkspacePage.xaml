<Page
    x:Class="RaayaGitDeploy.App.Views.RepositoryWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:workspace="using:RaayaGitDeploy.Presentation.Workspace"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Raaya Git Deploy" />
                <TextBlock Opacity="0.65" Text="Review · Verify · Deploy" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.RepositoryPath, Mode=OneWay}" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.BranchName, Mode=OneWay}" />
                    <TextBlock Opacity="0.5" Text="{x:Bind ViewModel.HeadSha, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Width="24"
                    Height="24"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button Click="OpenRepository_Click" Content="Open repository" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="16"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Source" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="WorkingTree_Click"
                        Content="Working Tree" />
                    <TextBox
                        x:Name="BaseRefTextBox"
                        Header="Compare since ref"
                        PlaceholderText="HEAD~1, main, commit SHA" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="Compare_Click"
                        Content="Compare" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Opacity="0.6"
                        Text="Review state and deployment selection are intentionally independent."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Changes" />
                    <ListView
                        x:Name="ChangesList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                        SelectionChanged="ChangesList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="workspace:ChangeItemViewModel">
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock FontSize="12" Text="{x:Bind Kind}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.55"
                                            Text="{x:Bind OriginalPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="ReviewStateComboBox"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Loaded="ReviewStateComboBox_Loaded"
                                        SelectionChanged="ReviewStateComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Unreviewed" />
                                        <ComboBoxItem Content="Approved" />
                                        <ComboBoxItem Content="Excluded" />
                                    </ComboBox>

                                    <CheckBox
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        Content="Deploy"
                                        IsChecked="{x:Bind IsSelectedForDeployment, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Diff inspector" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.SelectedDiffText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="Git operation failed" />
    </Grid>
</Page>
