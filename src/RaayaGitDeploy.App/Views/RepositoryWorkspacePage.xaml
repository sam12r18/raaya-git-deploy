<Page x:Class="RaayaGitDeploy.App.Views.RepositoryWorkspacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Repository Workspace" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.RepositoryPath, Mode=OneWay}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.AbbreviatedHeadSha, Mode=OneWay}" FontFamily="Consolas"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Open Repository" Click="OpenRepository_Click"/><Button Content="Refresh" Click="WorkingTree_Click"/></StackPanel></Grid>
<Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NavigationView x:Name="WorkbenchNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="220" CompactPaneLength="48" IsPaneOpen="True" SelectionChanged="WorkbenchNavigation_SelectionChanged"><NavigationView.MenuItems><NavigationViewItem Content="Changes" Tag="Changes"/><NavigationViewItem Content="Commits" Tag="Commits"/><NavigationViewItem Content="Terminal" Tag="Terminal"/><NavigationViewItem Content="Commands" Tag="Commands"/><NavigationViewItem Content="Deploy Queue" Tag="DeployQueue"/><NavigationViewItem Content="Servers" Tag="Servers"/><NavigationViewItem Content="History" Tag="History"/></NavigationView.MenuItems></NavigationView>
<Grid Grid.Column="1"><Grid x:Name="ChangesWorkspace"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="BaseRefTextBox" Width="180" PlaceholderText="Compare ref"/><Button Content="Compare" Click="Compare_Click"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Stage selected" Click="StageSelected_Click"/><Button Content="Unstage selected" Click="UnstageSelected_Click"/><TextBlock x:Name="GitMutationStatus" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel><ListView Grid.Row="2" x:Name="ChangesList" ItemsSource="{x:Bind ViewModel.Changes}" SelectionMode="Extended" SelectionChanged="ChangesList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Path}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding IsStaged}"/><TextBlock Grid.Column="2" Text="{Binding IsUnstaged}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Grid Grid.Row="3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommitMessageTextBox" Header="Commit message" PlaceholderText="Describe the staged changes"/><Button Grid.Column="1" Content="Commit staged" VerticalAlignment="Bottom" Click="CommitStaged_Click"/></Grid></Grid><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{x:Bind ViewModel.SelectedDiffText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer></Grid></Grid>
<Grid x:Name="CommitsWorkspace" Visibility="Collapsed" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="320"/><ColumnDefinition Width="4*" MinWidth="220"/><ColumnDefinition Width="8*"/></Grid.ColumnDefinitions><Grid Padding="8,4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Commit" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Author" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="SHA" FontWeight="SemiBold"/></Grid><TextBlock Grid.Column="1" Text="Changed paths" FontWeight="SemiBold" Padding="8,4"/><TextBlock Grid.Column="2" Text="Diff" FontWeight="SemiBold" Padding="8,4"/></Grid><Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="320"/><ColumnDefinition Width="4*" MinWidth="220"/><ColumnDefinition Width="8*"/></Grid.ColumnDefinitions><ListView x:Name="CommitsList" ItemsSource="{x:Bind ViewModel.Commits}" SelectionChanged="CommitsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="8,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Subject}"/><TextBlock Grid.Column="1" Text="{Binding AuthorName}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding AuthorDate}" Opacity="0.72"/><TextBlock Grid.Column="3" Text="{Binding ShortSha}" FontFamily="Consolas" Opacity="0.72"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><ListView Grid.Column="1" x:Name="CommitFilesList" ItemsSource="{x:Bind ViewModel.CommitChanges}" SelectionChanged="CommitFilesList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/></DataTemplate></ListView.ItemTemplate></ListView><ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{x:Bind ViewModel.SelectedCommitDiffText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer></Grid></Grid>
<Grid x:Name="TerminalWorkspace" Visibility="Collapsed" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Terminal"/><TextBlock x:Name="TerminalState" Text="Stopped"/><Button Content="Start / Restart" Click="TerminalStart_Click"/><Button Content="Stop" Click="TerminalStop_Click"/></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TerminalOutput" FontFamily="Consolas" TextWrapping="NoWrap"/></ScrollViewer><Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TerminalInput" PlaceholderText="PowerShell command"/><Button Grid.Column="1" Content="Run" Click="TerminalSend_Click"/></Grid></Grid>
<Grid x:Name="CommandsWorkspace" Visibility="Collapsed" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Saved Commands" Style="{ThemeResource TitleTextBlockStyle}"/><ListView x:Name="CommandsList" SelectionChanged="CommandsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CommandText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBox x:Name="CommandName" Header="Name"/><TextBox x:Name="CommandText" Header="Command" FontFamily="Consolas" AcceptsReturn="True"/><TextBox x:Name="CommandWorkingDirectory" Header="Working directory override (optional)"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="New" Click="CommandNew_Click"/><Button Content="Save" Click="CommandSave_Click"/><Button Content="Run" Click="CommandRun_Click"/><Button Content="Delete" Click="CommandDelete_Click"/></StackPanel></StackPanel></Grid>
<Grid x:Name="DeployQueueWorkspace" Visibility="Collapsed" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Deploy Queue" Style="{ThemeResource TitleTextBlockStyle}"/><Button Content="Add selected change" Click="DeployAddSelectedChange_Click"/><Button Content="Clear" Click="DeployClear_Click"/><Button Content="Dry Run" Click="DryRun_Click"/><Button Content="Deploy" Click="Deploy_Click"/></StackPanel><ListView Grid.Row="1" x:Name="DeployQueueList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4"><TextBlock Text="{Binding LocalPath}" FontFamily="Consolas"/><TextBlock Text="{Binding Source}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="Dry Run mapping" FontWeight="SemiBold"/><ListView x:Name="DryRunList"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LocalPath}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding RemotePath}" FontFamily="Consolas"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="DeployResultText" TextWrapping="Wrap"/></StackPanel></Grid>
<Grid x:Name="ServersWorkspace" Visibility="Collapsed" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Servers" Style="{ThemeResource TitleTextBlockStyle}"/><ListView x:Name="ServersList" SelectionChanged="ServersList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Host}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBox x:Name="ServerName" Header="Name"/><TextBox x:Name="ServerHost" Header="Host"/><TextBox x:Name="ServerPort" Header="Port" Text="22"/><TextBox x:Name="ServerUsername" Header="Username"/><TextBox x:Name="ServerRemoteRoot" Header="Remote root" PlaceholderText="/var/www/app"/><TextBox x:Name="ServerKeyReference" Header="SSH key reference/path"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="New" Click="ServerNew_Click"/><Button Content="Save" Click="ServerSave_Click"/><Button Content="Delete" Click="ServerDelete_Click"/><Button Content="Test Connection" Click="ServerTest_Click"/></StackPanel><TextBlock x:Name="ServerConnectionStatus" TextWrapping="Wrap"/><TextBlock Text="Secrets are not stored in the profile. SSH credentials remain outside the profile store." TextWrapping="Wrap"/></StackPanel></Grid>
<Grid x:Name="HistoryWorkspace" Visibility="Collapsed" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Deployment History" Style="{ThemeResource TitleTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="HistoryRefresh_Click"/><Button Content="Prepare retry" Click="HistoryPrepareRetry_Click"/></StackPanel><ListView x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding ServerDisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding StartedAt}"/><TextBlock Text="{Binding Succeeded}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Result details" FontWeight="SemiBold"/><ListView x:Name="HistoryDetailsList"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding Operation.RemotePath}" FontFamily="Consolas"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="HistoryRecoveryText" Text="Select a failed deployment and choose Prepare retry. Failed/blocked uploads will be re-queued and a new Dry Run is required before deployment." TextWrapping="Wrap"/></StackPanel></Grid></Grid></Grid>
<InfoBar x:Name="ErrorInfoBar" Grid.RowSpan="2" IsOpen="False" Severity="Error" IsClosable="True" VerticalAlignment="Top"/></Grid></Page>